# Firebase web app configuration for optional cross-device sync.
#
# Copy this file to .env.local for local development, and add the same six
# values as GitHub repository variables so the Pages build can use them.
# These are public client identifiers, not secrets: access is controlled by
# Firestore security rules and by the Authorized domains list in Firebase.
#
# Leave them empty to build the app in local-only mode (no sign-in, no network).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
